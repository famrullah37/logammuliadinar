# Salin ke .env lalu isi. File .env berisi rahasia: jangan di-commit, chmod 600 di server.

# ── Wajib ──────────────────────────────────────────────────────────
# Postgres 17 yang sudah ada di VPS (container postgresql-wsnb-postgresql-1).
# Pakai DATABASE & USER KHUSUS aplikasi ini, bukan superuser. Buat sekali:
#   docker exec -it postgresql-wsnb-postgresql-1 psql -U postgres -c "CREATE USER lmd WITH PASSWORD 'PASSWORD_KUAT';"
#   docker exec -it postgresql-wsnb-postgresql-1 psql -U postgres -c "CREATE DATABASE logammuliadinar OWNER lmd;"
DATABASE_URL=postgresql://lmd:PASSWORD_KUAT@postgresql-wsnb-postgresql-1:5432/logammuliadinar

# Redis bersama (container redis_shared) memakai password. Pakai nomor database
# yang belum dipakai aplikasi lain (cek: docker exec -e REDISCLI_AUTH='...' redis_shared redis-cli info keyspace).
# Karakter khusus di password harus di-encode URL (mis. @ → %40, / → %2F).
REDIS_URL=redis://:PASSWORD_REDIS@redis_shared:6379/5

# Minimal 32 karakter acak. Buat dengan: openssl rand -base64 48
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

DOMAIN=logammuliadinar.com

# ── Infrastruktur VPS (nilai bawaan sudah sesuai; ubah hanya bila berbeda) ──
# TRAEFIK_NETWORK=proxy
# POSTGRES_NETWORK=postgresql-wsnb_default
# REDIS_NETWORK=redis_public
# TRAEFIK_CERTRESOLVER=le
# TRAEFIK_HTTPS_ENTRYPOINT=websecure
# TRAEFIK_HTTP_ENTRYPOINT=web

# ── Pengembangan lokal saja (npm run dev) ──────────────────────────
# DATABASE_URL=postgresql://lmd:ganti-password@localhost:5432/logammuliadinar
# REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_SITE_URL=http://localhost:3000

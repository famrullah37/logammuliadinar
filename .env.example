# ── Pengembangan lokal (npm run dev) ─────────────────────────────
DATABASE_URL=postgresql://lmd:ganti-password@localhost:5432/logammuliadinar
# Minimal 32 karakter acak. Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opsional di lokal: tanpa REDIS_URL, rate limit disimpan di memori proses.
REDIS_URL=redis://localhost:6379

# ── Produksi (docker compose) ────────────────────────────────────
DOMAIN=logammuliadinar.com
ACME_EMAIL=admin@logammuliadinar.com
POSTGRES_USER=lmd
POSTGRES_PASSWORD=ganti-password-kuat
POSTGRES_DB=logammuliadinar
